{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "louismaudotcom",
  // Set this to today's date
  "compatibility_date": "2026-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "louismau.com",
      "custom_domain": true
    }
   ],
  "kv_namespaces": [
    {
      "binding": "SITE_CONFIG",
      "id": "02cb9c8ec0364f39b7824de4ca6a2bc4",
      "preview_id": "f8707bd200f5427b89b50a49df38868a"
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "preview"
      },
      "kv_namespaces": [
        {
          "binding": "SITE_CONFIG",
          "id": "f8707bd200f5427b89b50a49df38868a"
        }
      ]
    }
  }
}
