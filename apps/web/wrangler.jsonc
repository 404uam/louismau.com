{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "louismaudotcom",
  // Set this to today's date
  "compatibility_date": "2026-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "louismau.com",
      "custom_domain": true
    }
   ],
  "kv_namespaces": [
    {
      "binding": "SITE_CONFIG",
      "id": "<REPLACE_WITH_ID_FROM_WRANGLER_CREATE>",
      "preview_id": "<REPLACE_WITH_PREVIEW_ID>"
    }
  ]
}
